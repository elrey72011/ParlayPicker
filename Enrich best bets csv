def run_csv_enricher_ui():
    """
    Add this to your Streamlit app to enrich existing CSVs
    """
    st.header("🔧 Best Bets CSV Enricher")
    
    st.write("""
    Upload your incomplete best bets CSV and this will fill in:
    - ✅ theover.ai predictions
    - ✅ ML predictions (if missing)
    - ✅ SportsData stats (if missing)
    """)
    
    # Upload incomplete CSV
    uploaded_csv = st.file_uploader("Upload Incomplete Best Bets CSV", type=['csv'])
    
    if uploaded_csv is not None:
        # Check if theover data is loaded
        if 'theover_spreads_data' not in st.session_state:
            st.error("❌ Please load theover.ai data first!")
            return
        
        theover_df = st.session_state['theover_spreads_data']
        
        if st.button("🚀 Enrich CSV", type="primary"):
            # Save uploaded file temporarily
            import tempfile
            with tempfile.NamedTemporaryFile(delete=False, suffix='.csv') as tmp:
                tmp.write(uploaded_csv.getvalue())
                tmp_path = tmp.name
            
            # Enrich it
            enriched_df = enrich_best_bets_csv(
                incomplete_csv_path=tmp_path,
                theover_df=theover_df,
                ml_predictor=st.session_state.get('ml_predictor'),
                sportsdata_clients=st.session_state.get('sportsdata_clients')
            )
            
            # Show preview
            st.write("### 📊 Enriched CSV Preview")
            st.dataframe(enriched_df.head())
            
            # Download button
            csv = enriched_df.to_csv(index=False)
            st.download_button(
                "📥 Download Enriched CSV",
                csv,
                f"best_bets_enriched_{pd.Timestamp.now().strftime('%Y%m%d_%H%M%S')}.csv",
                "text/csv",
                key='download_enriched'
            )
            
            # Cleanup
            import os
            os.unlink(tmp_path)



          "text": "    v1.require(version in {v1.VERSION, v2.VERSION, v3.VERSION, v4.VERSION}, 'NFL_PRIVATE_PACKET_SCHEMA')\n    return {v1.VERSION:v1,v2.VERSION:v2,v3.VERSION:v3,v4.VERSION:v4}[version]\n"
